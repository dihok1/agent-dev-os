# Notion task database (T3+)
# Create an internal integration, share the database with it, then set:
# NOTION_TOKEN=<integration secret>
# NOTION_DATABASE_ID=<database id>
#
# Required database properties (rich_text unless noted):
#   Name (title), Status, Project, Priority, Deadline, Author,
#   Source (url), Source Key, Body, Attachments
NOTION_TOKEN=
NOTION_DATABASE_ID=

